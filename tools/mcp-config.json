{
  "$schema": "https://raw.githubusercontent.com/anonymous99-Rise/multi-CyberSecurity/main/tools/mcp-config.schema.json",
  "name": "multi-CyberSecurity Tools",
  "version": "1.1.0",
  "description": "统一工具 MCP 配置 - 方便 Agents 按需调用",

  "tools": {
    "burp-mcp": {
      "type": "mcp",
      "name": "BurpSuite MCP Server (官方)",
      "path": "vendor/burp-mcp",
      "enabled": true,
      "build": "cd vendor/burp-mcp && ./gradlew build",
      "run": "cd vendor/burp-mcp && ./gradlew run",
      "capabilities": [
        "proxy",
        "scanner",
        "intruder",
        "repeater",
        "sequencer",
        "decoder",
        "comparer"
      ]
    },

    "redteam-mcp": {
      "type": "mcp",
      "name": "RedTeam Agent MCP Server",
      "path": "vendor/redteam-mcp",
      "enabled": true,
      "description": "RedTeam 工具封装 MCP 服务器"
    },

    "playwright": {
      "type": "local",
      "name": "Playwright Browser Automation",
      "command": "npx playwright",
      "browsers": ["chromium", "firefox", "webkit"],
      "headless": true,
      "slow_mo": 100,
      "enabled": true,
      "scripts": "tools/playwright/scripts",
      "templates": "tools/playwright/templates"
    },

    "chromium-cdp": {
      "type": "cdp",
      "name": "Chrome/Edge CDP Debugging",
      "executable": {
        "win32": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
        "linux": "/usr/bin/chromium",
        "darwin": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
      },
      "remote_debugging_port": 9222,
      "enabled": true,
      "commands": "tools/chromium/cdp-commands"
    },

    "fscan": {
      "type": "local",
      "name": "fscan (内网综合扫描)",
      "binary": {
        "win32": "fscan.exe",
        "linux": "./fscan",
        "darwin": "./fscan"
      },
      "templates": "tools/fscan/templates",
      "enabled": true
    },

    "kali": {
      "type": "ssh",
      "name": "Kali Linux Tools",
      "host": "kali.local",
      "port": 22,
      "user": "root",
      "enabled": true,
      "tools": {
        "recon": ["nmap", "masscan", "rustscan", "ffuf", "gobuster"],
        "vuln_scan": ["nuclei", "nikto", "sqlmap", "xsstrike"],
        "privesc": ["linpeas", "linEnum", "winpeas"],
        "ad": ["bloodhound", "crackmapexec", "impacket", "mimikatz"],
        "web": ["burpsuite", "OWASP ZAP", "wfuzz"]
      }
    },

    "nuclei": {
      "type": "local",
      "name": "Nuclei Vulnerability Scanner",
      "command": "nuclei",
      "enabled": true
    }
  },

  "knowledge": {
    "vulnerability-wiki-poc": {
      "type": "git-submodule",
      "path": "external/Vulnerability-Wiki-PoC",
      "description": "1Day PoC 归档 (2024-2026)",
      "enabled": true,
      "structure": {
        "2024": "2024年漏洞 PoC",
        "2025": "2025年漏洞 PoC",
        "2026": "2026年漏洞 PoC"
      }
    },

    "cve-monitor": {
      "type": "git-submodule",
      "path": "external/cve_monitor",
      "description": "CVE RSS/Tracker 监控",
      "enabled": true,
      "files": {
        "cve_script": "external/cve_monitor/CVE_monitor.py",
        "rss": "external/cve_monitor/RSS/",
        "archive": "external/cve_monitor/archive/"
      }
    },

    "claude-bughunter": {
      "type": "git-submodule",
      "path": "external/Claude-BugHunter",
      "description": "Bug Hunting 技能包 (71 skills)",
      "enabled": true
    },

    "anthropic-security-skills": {
      "type": "git-submodule",
      "path": "external/Anthropic-Cybersecurity-Skills",
      "description": "AI 安全技能库 (817 skills)",
      "enabled": true
    },

    "reverse-skill": {
      "type": "git-submodule",
      "path": "external/reverse-skill",
      "description": "逆向/CTF 技能包 (40场景)",
      "enabled": true
    }
  },

  "routing": {
    "web_recon": {
      "description": "Web 应用信息搜集",
      "tools": ["nmap", "ffuf", "nuclei"]
    },
    "vuln_scan": {
      "description": "漏洞扫描",
      "tools": ["nuclei", "sqlmap", "xsstrike"]
    },
    "ad_attack": {
      "description": "内网域渗透",
      "tools": ["bloodhound", "crackmapexec", "impacket"]
    },
    "browser_auto": {
      "description": "浏览器自动化",
      "tools": ["playwright", "chromium-cdp"]
    },
    "burp_proxy": {
      "description": "BurpSuite 代理扫描",
      "tools": ["burp-mcp"]
    }
  },

  "execution": {
    "max_concurrent": 5,
    "timeout_seconds": 300,
    "retry_count": 2,
    "output_format": "json",
    "output_dir": "results"
  }
}
